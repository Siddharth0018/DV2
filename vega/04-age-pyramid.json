{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian gamers by age band, filterable by gender. A bound dropdown switches between Women and Men; bars are ordered by overall share of all gamers.",
  "width": "container",
  "height": 420,
  "background": "transparent",
  "padding": {"left": 0, "right": 28, "top": 16, "bottom": 16},
  "data": {"url": "data/age-gender.csv"},
  "params": [
    {
      "name": "Gender",
      "value": "Women",
      "bind": {"input": "select", "options": ["Women", "Men"], "name": "Show gender:  "}
    }
  ],
  "transform": [
    {"fold": ["female_pct", "male_pct"], "as": ["gender_key", "pct"]},
    {"calculate": "datum.gender_key === 'female_pct' ? 'Women' : 'Men'", "as": "gender"},
    {"filter": "datum.gender === Gender"}
  ],
  "encoding": {
    "y": {
      "field": "age_band",
      "type": "ordinal",
      "sort": {"field": "total_pct", "order": "descending"},
      "axis": {
        "title": null,
        "labelColor": "#dde0ea",
        "labelFont": "Space Grotesk",
        "labelFontSize": 14,
        "labelFontWeight": 600,
        "labelPadding": 12,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "pct",
      "type": "quantitative",
      "scale": {"domain": [0, 11]},
      "axis": {
        "title": "% of all Australian gamers",
        "titleColor": "#aab0c2",
        "titleFont": "Inter",
        "titleFontSize": 11,
        "titlePadding": 12,
        "labelColor": "#9097ac",
        "labelFontSize": 11,
        "labelFont": "Inter",
        "tickColor": "#2a3050",
        "domain": false,
        "grid": true,
        "gridColor": "#1a1f35",
        "gridDash": [2, 4],
        "format": ".0f"
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4, "height": {"band": 0.68}},
      "encoding": {
        "color": {
          "field": "gender",
          "type": "nominal",
          "scale": {"domain": ["Women", "Men"], "range": ["#F4287F", "#5DE2E7"]},
          "legend": null
        },
        "tooltip": [
          {"field": "age_band", "type": "nominal", "title": "Age band"},
          {"field": "gender", "type": "nominal", "title": "Gender"},
          {"field": "pct", "type": "quantitative", "title": "% of all gamers", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 8, "font": "Space Grotesk", "fontSize": 13, "fontWeight": 700, "color": "#ffffff"},
      "encoding": {
        "text": {"field": "pct", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "Inter"}
  }
}
